+    public static int getNoticeDotOccupiedSize(int iconSizePx) {
+        float dotSize = iconSizePx * 0.24f;
+        int dotOccupiedSize = (int) Math.ceil(0.6f * dotSize);
+        return dotOccupiedSize;
