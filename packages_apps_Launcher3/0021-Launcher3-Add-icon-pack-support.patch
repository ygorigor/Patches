diff --git a/src/com/android/launcher3/icons/IconPack.kt b/src/com/android/launcher3/icons/IconPack.kt
new file mode 100644
index 00000000000..4789446ddf9
--- /dev/null
+++ b/src/com/android/launcher3/icons/IconPack.kt
@@ -0,0 +1,62 @@
+package com.android.launcher3.icons
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ResolveInfo
+import android.content.res.Resources
+import android.graphics.drawable.Drawable
+import org.xmlpull.v1.XmlPullParser
+import org.xmlpull.v1.XmlPullParserFactory
+
+class IconPack(private val pkg: String, private val res: Resources, private val map: Map<String, String>) {
+
+    fun getIcon(packageName: String, className: String?, density: Int): Drawable? {
+        val name = className?.let { map["$packageName/$it"] } ?: map[packageName] ?: return null
+        val id = res.getIdentifier(name, "drawable", pkg)
+        return if (id == 0) null else try {
+            res.getDrawableForDensity(id, density, null)
+        } catch (e: Exception) {
+            null
+        }
+    }
+
+    companion object {
+        private val ACTIONS = arrayOf("org.adw.launcher.THEMES", "com.novalauncher.THEME")
+        private var cached: IconPack? = null
+
+        @JvmStatic
+        fun getPacks(context: Context): List<ResolveInfo> =
+            ACTIONS.flatMap { context.packageManager.queryIntentActivities(Intent(it), 0) }
+                .distinctBy { it.activityInfo.packageName }
+
+        @JvmStatic
+        @Synchronized
+        fun get(context: Context, pkg: String): IconPack? {
+            if (pkg.isEmpty()) return null
+            cached?.takeIf { it.pkg == pkg }?.let { return it }
+            return load(context, pkg)?.also { cached = it }
+        }
+
+        @JvmStatic
+        fun load(context: Context, pkg: String): IconPack? = try {
+            val res = context.packageManager.getResourcesForApplication(pkg)
+            val id = res.getIdentifier("appfilter", "xml", pkg)
+            val parser = if (id != 0) res.getXml(id) else XmlPullParserFactory.newInstance()
+                .newPullParser().apply { setInput(res.assets.open("appfilter.xml"), null) }
+            val map = HashMap<String, String>()
+            while (parser.next() != XmlPullParser.END_DOCUMENT) {
+                if (parser.eventType != XmlPullParser.START_TAG || parser.name != "item") continue
+                val drawable = parser.getAttributeValue(null, "drawable") ?: continue
+                val cn = parser.getAttributeValue(null, "component")
+                    ?.removePrefix("ComponentInfo{")?.removeSuffix("}")
+                    ?.let(ComponentName::unflattenFromString) ?: continue
+                map.putIfAbsent("${cn.packageName}/${cn.className}", drawable)
+                map.putIfAbsent(cn.packageName, drawable)
+            }
+            IconPack(pkg, res, map)
+        } catch (e: Exception) {
+            null
+        }
+    }
+}
diff --git a/src/com/android/launcher3/settings/IconPackPreference.kt b/src/com/android/launcher3/settings/IconPackPreference.kt
new file mode 100644
index 00000000000..a91fa37cbce
--- /dev/null
+++ b/src/com/android/launcher3/settings/IconPackPreference.kt
@@ -0,0 +1,79 @@
+package com.android.launcher3.settings
+
+import android.app.AlertDialog
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ResolveInfo
+import android.util.AttributeSet
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.RadioButton
+import android.widget.ScrollView
+import androidx.preference.Preference
+import com.android.launcher3.R
+import com.android.launcher3.icons.IconPack
+import com.android.launcher3.util.Executors.MAIN_EXECUTOR
+import com.android.launcher3.util.Executors.UI_HELPER_EXECUTOR
+
+class IconPackPreference(context: Context, attrs: AttributeSet?) : Preference(context, attrs) {
+
+    override fun onAttached() {
+        super.onAttached()
+        updateSummary()
+    }
+
+    private fun updateSummary() {
+        val current = getPersistedString("")
+        summary = IconPack.getPacks(context).firstOrNull { it.activityInfo.packageName == current }
+            ?.loadLabel(context.packageManager) ?: context.getString(R.string.icon_pack_default)
+    }
+
+    override fun onClick() {
+        val pm = context.packageManager
+        val d = context.resources.displayMetrics.density
+        val apps = pm.queryIntentActivities(
+            Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER), 0)
+        val current = getPersistedString("")
+        val list = LinearLayout(context).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding((20 * d).toInt(), (8 * d).toInt(), (20 * d).toInt(), 0)
+        }
+        val dialog = AlertDialog.Builder(context).setTitle(title)
+            .setView(ScrollView(context).apply { addView(list) }).create()
+        (listOf<ResolveInfo?>(null) + IconPack.getPacks(context)).forEach { ri ->
+            val pkg = ri?.activityInfo?.packageName ?: ""
+            val previews = LinearLayout(context)
+            list.addView(LinearLayout(context).apply {
+                orientation = LinearLayout.VERTICAL
+                setPadding(0, (8 * d).toInt(), 0, (8 * d).toInt())
+                addView(RadioButton(context).apply {
+                    text = ri?.loadLabel(pm) ?: context.getString(R.string.icon_pack_default)
+                    isChecked = pkg == current
+                    isClickable = false
+                })
+                addView(previews)
+                setOnClickListener {
+                    persistString(pkg)
+                    updateSummary()
+                    dialog.dismiss()
+                }
+            })
+            UI_HELPER_EXECUTOR.execute {
+                val pack = IconPack.load(context, pkg)
+                val icons = apps.asSequence().mapNotNull {
+                    if (pkg.isEmpty()) it.loadIcon(pm)
+                    else pack?.getIcon(it.activityInfo.packageName, it.activityInfo.name, 0)
+                }.take(6).toList()
+                MAIN_EXECUTOR.execute {
+                    icons.forEach {
+                        previews.addView(ImageView(context).apply {
+                            setImageDrawable(it)
+                            layoutParams = LinearLayout.LayoutParams(0, (40 * d).toInt(), 1f)
+                        })
+                    }
+                }
+            }
+        }
+        dialog.show()
+    }
+}
