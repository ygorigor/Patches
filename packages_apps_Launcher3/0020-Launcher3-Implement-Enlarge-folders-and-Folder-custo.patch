+package com.android.launcher3.folder;
+
+public class GridFolderLayoutRule extends ClippedFolderIconLayoutRule {
+
+    public static final int MAX_NUM_ITEMS_IN_PREVIEW = 9;
+    private static final int GRID_SIZE = 3;
+
+    @Override
+    public PreviewItemDrawingParams computePreviewItemDrawingParams(int index, int curNumItems,
+            PreviewItemDrawingParams params) {
+        float totalScale = scaleForItem(curNumItems, 0);
+        float iconSizeScaled = mIconSize * totalScale;
+        float spacing = (mAvailableSpace - (GRID_SIZE * iconSizeScaled)) / (GRID_SIZE + 1);
+        int col = index % GRID_SIZE;
+        if (mIsRtl) {
+            col = GRID_SIZE - 1 - col;
+        }
+        float transX = spacing + col * (iconSizeScaled + spacing);
+        float transY = spacing + (index / GRID_SIZE) * (iconSizeScaled + spacing);
+        if (index < 0 || index >= MAX_NUM_ITEMS_IN_PREVIEW) {
+            transX = transY = (mAvailableSpace - iconSizeScaled) / 2;
+        }
+        if (params == null) {
+            return new PreviewItemDrawingParams(transX, transY, totalScale);
+        }
+        params.update(transX, transY, totalScale);
+        return params;
+    }
+
+    @Override
+    public PreviewItemDrawingParams computeSpringAnimationItemParams(int index, int numItemsInPage,
+            int page, int numFolderColumns, PreviewItemDrawingParams params) {
+        return computePreviewItemDrawingParams(page == 0 ? index : -1,
+                Math.min(numItemsInPage, MAX_NUM_ITEMS_IN_PREVIEW), params);
+    }
+
+    @Override
+    public float scaleForItem(int numItems, int page) {
+        return 0.28f * mBaselineIconScale;
+    }
+}
