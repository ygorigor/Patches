+private val COVER_PRESETS = listOf(
+    "📁", "⭐", "🎮", "🎵", "📷", "💼", "🏠", "❤️", "🔧", "📚",
+    "💬", "🛒", "💰", "🎬", "✈️", "🍔", "💪", "🎨", "📱", "🔒"
