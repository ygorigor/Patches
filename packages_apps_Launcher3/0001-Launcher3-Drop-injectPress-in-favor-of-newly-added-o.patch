From 2e633f53eada994e0b6ed74cd295ef1f44dd9fa1 Mon Sep 17 00:00:00 2001
From: Bruno Martins <bgcngm@gmail.com>
Date: Thu, 4 Dec 2025 12:28:54 +0000
Subject: [PATCH] Launcher3: Drop injectPress in favor of newly added
 onKeyEvent method

Change-Id: Ie16d05fbbad770b6d5edfbff8d9f7d7792c9cede
---
 .../launcher3/taskbar/TaskbarNavButtonController.java        | 2 +-
 quickstep/src/com/android/quickstep/SystemUiProxy.kt         | 5 -----
 2 files changed, 1 insertion(+), 6 deletions(-)

diff --git a/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java b/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java
index a4c0eb865e..7ae5117c89 100644
--- a/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java
+++ b/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java
@@ -156,7 +156,7 @@ public class TaskbarNavButtonController implements TaskbarControllers.LoggableTa
                 logEvent(LAUNCHER_TASKBAR_HOME_BUTTON_TAP);
                 mSystemUiProxy.updateContextualEduStats(/* isTrackpadGesture= */ false,
                         GestureType.HOME);
-                mSystemUiProxy.injectPress(KeyEvent.KEYCODE_HOME);
+                mSystemUiProxy.onKeyEvent(KeyEvent.KEYCODE_HOME, mDisplayId);
                 break;
             case BUTTON_RECENTS:
                 logEvent(LAUNCHER_TASKBAR_OVERVIEW_BUTTON_TAP);
diff --git a/quickstep/src/com/android/quickstep/SystemUiProxy.kt b/quickstep/src/com/android/quickstep/SystemUiProxy.kt
index 5445f4406a..3eb1b1f0a3 100644
--- a/quickstep/src/com/android/quickstep/SystemUiProxy.kt
+++ b/quickstep/src/com/android/quickstep/SystemUiProxy.kt
@@ -228,11 +228,6 @@ class SystemUiProxy @Inject constructor(@ApplicationContext private val context:
             systemUiProxy?.injectLongPress(keyCode)
         }
 
-    fun injectPress(keyCode: Int) =
-        executeWithErrorLog({ "Failed call injectPress" }) {
-            systemUiProxy?.injectPress(keyCode)
-        }
-
     fun onImeSwitcherPressed() =
         executeWithErrorLog({ "Failed call onImeSwitcherPressed" }) {
             systemUiProxy?.onImeSwitcherPressed()
-- 
2.43.0

