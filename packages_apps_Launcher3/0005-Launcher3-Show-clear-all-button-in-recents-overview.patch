         mSaveAppPairButton.setOnClickListener(this);
+        findViewById(R.id.action_clear_all).setOnClickListener(this);
     }
 
     /**
@@ -231,13 +232,15 @@ public class OverviewActionsView<T extends OverlayUICallbacks> extends FrameLayo
