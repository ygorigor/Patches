From 56994d7fb999cd0dd9cffd90dfa2a2953ec835c8 Mon Sep 17 00:00:00 2001
From: Michael Bestas <mkbestas@lineageos.org>
Date: Sat, 20 Dec 2025 03:00:31 +0200
Subject: [PATCH] fixup! Launcher3: Inject events for taskbar long press
 actions

Change-Id: Iae9d15c4a40064051e7823c8b8a918c1a4ad2bf8
---
 .../launcher3/taskbar/TaskbarNavButtonController.java     | 6 +++---
 quickstep/src/com/android/quickstep/SystemUiProxy.kt      | 8 +++++---
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java b/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java
index 7ae5117c89..facb57ab89 100644
--- a/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java
+++ b/quickstep/src/com/android/launcher3/taskbar/TaskbarNavButtonController.java
@@ -199,7 +199,7 @@ public class TaskbarNavButtonController implements TaskbarControllers.LoggableTa
         switch (buttonType) {
             case BUTTON_HOME:
                 logEvent(LAUNCHER_TASKBAR_HOME_BUTTON_LONGPRESS);
-                mSystemUiProxy.injectLongPress(KeyEvent.KEYCODE_HOME);
+                mSystemUiProxy.onLongPressKeyEvent(KeyEvent.KEYCODE_HOME, mDisplayId);
                 view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS,
                         HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
                 return true;
@@ -215,7 +215,7 @@ public class TaskbarNavButtonController implements TaskbarControllers.LoggableTa
                     view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS,
                             HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
                 } else {
-                    mSystemUiProxy.injectLongPress(KeyEvent.KEYCODE_BACK);
+                    mSystemUiProxy.onLongPressKeyEvent(KeyEvent.KEYCODE_BACK, mDisplayId);
                 }
                 return true;
             case BUTTON_RECENTS:
@@ -224,7 +224,7 @@ public class TaskbarNavButtonController implements TaskbarControllers.LoggableTa
                     view.performHapticFeedback(HapticFeedbackConstants.LONG_PRESS,
                             HapticFeedbackConstants.FLAG_IGNORE_VIEW_SETTING);
                 } else {
-                    mSystemUiProxy.injectLongPress(KeyEvent.KEYCODE_APP_SWITCH);
+                    mSystemUiProxy.onLongPressKeyEvent(KeyEvent.KEYCODE_APP_SWITCH, mDisplayId);
                 }
                 return true;
             case BUTTON_IME_SWITCH:
diff --git a/quickstep/src/com/android/quickstep/SystemUiProxy.kt b/quickstep/src/com/android/quickstep/SystemUiProxy.kt
index 3eb1b1f0a3..86a27e30e3 100644
--- a/quickstep/src/com/android/quickstep/SystemUiProxy.kt
+++ b/quickstep/src/com/android/quickstep/SystemUiProxy.kt
@@ -223,9 +223,11 @@ class SystemUiProxy @Inject constructor(@ApplicationContext private val context:
             systemUiProxy?.onKeyEvent(keycode, displayId)
         }
 
-    fun injectLongPress(keyCode: Int) =
-        executeWithErrorLog({ "Failed call injectLongPress" }) {
-            systemUiProxy?.injectLongPress(keyCode)
+    fun onLongPressKeyEvent(keycode: Int, displayId: Int) =
+        executeWithErrorLog({
+            "Failed call onLongPressKeyEvent ${KeyEvent.keyCodeToString(keycode)}"
+        }) {
+            systemUiProxy?.onLongPressKeyEvent(keycode, displayId)
         }
 
     fun onImeSwitcherPressed() =
-- 
2.43.0

