From: ygorigor <sorocean.igor@gmail.com>
Date: Fri, 10 Apr 2026 11:30:10 +0300
Subject: [PATCH] sm8550-common: config_vibrateOnIconAnimation -> true

---
 overlay/SystemUIOverlayCommon/res/values/config.xml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/overlay/SystemUIOverlayCommon/res/values/config.xml b/overlay/SystemUIOverlayCommon/res/values/config.xml
index 868e9dd..abda0b1 100644
--- a/overlay/SystemUIOverlayCommon/res/values/config.xml
+++ b/overlay/SystemUIOverlayCommon/res/values/config.xml
@@ -22,4 +22,8 @@
 <resources>
     <!-- Doze: does this device support STATE_DOZE?  -->
     <bool name="doze_display_state_supported">true</bool>
+
+    <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
+     vibrator is capable of subtle vibrations -->
+    <bool name="config_vibrateOnIconAnimation">true</bool>
 </resources>
-- 
