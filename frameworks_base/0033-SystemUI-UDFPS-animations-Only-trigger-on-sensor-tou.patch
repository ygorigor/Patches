From 23258b6f7135b503d2ed6ebaaa87cab7e5da3ff0 Mon Sep 17 00:00:00 2001
From: grep <grepfox@tutamail.com>
Date: Tue, 27 Oct 2026 19:33:15 +0100
Subject: [PATCH] SystemUI: UDFPS animations: Only trigger on sensor touch

Change-Id: I83fc20e6f6dd67f86612cdf13db005b903fda4dc
---
 .../systemui/biometrics/ui/view/UdfpsTouchOverlay.kt  | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/biometrics/ui/view/UdfpsTouchOverlay.kt b/packages/SystemUI/src/com/android/systemui/biometrics/ui/view/UdfpsTouchOverlay.kt
index 2ab063fcf438..e12115865dc4 100644
--- a/packages/SystemUI/src/com/android/systemui/biometrics/ui/view/UdfpsTouchOverlay.kt
+++ b/packages/SystemUI/src/com/android/systemui/biometrics/ui/view/UdfpsTouchOverlay.kt
@@ -37,6 +37,7 @@ class UdfpsTouchOverlay(context: Context, attrs: AttributeSet?) : FrameLayout(co
     private var ghbmView: UdfpsSurfaceView? = null
     private var animView: UdfpsAnimView? = null
     private var udfpsDisplayMode: UdfpsDisplayModeProvider? = null
+    private var isSensorPressed = false
 
     // sensorRect may be bigger than the sensor. True sensor dimensions are defined in
     // overlayParams.sensorBounds
@@ -77,8 +78,14 @@ class UdfpsTouchOverlay(context: Context, attrs: AttributeSet?) : FrameLayout(co
 
     override fun dispatchTouchEvent(event: MotionEvent): Boolean {
         when (event.actionMasked) {
-            MotionEvent.ACTION_DOWN -> animView?.expand()
-            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> animView?.hide()
+            MotionEvent.ACTION_DOWN -> {
+                isSensorPressed = sensorRect.contains(event.x.toInt(), event.y.toInt())
+                if (isSensorPressed) animView?.expand()
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                if (isSensorPressed) animView?.hide()
+                isSensorPressed = false
+            }
         }
         return super.dispatchTouchEvent(event)
     }
-- 
2.56.0

