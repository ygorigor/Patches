From bd886868c6e1c7c96c3196c36a71cfd740b167b9 Mon Sep 17 00:00:00 2001
From: LuK1337 <priv.luk@gmail.com>
Date: Sun, 16 Nov 2025 10:56:33 +0100
Subject: [PATCH] sm6150-common: Opt out of speaker_layout_channel_mask field

Required for ABI compatibility with audio HAL compiled before 15 QPR2.

Fixes: https://gitlab.com/LineageOS/issues/android/-/issues/9426
Change-Id: Ic910f0634ee0707c21dad77f5264fd89fb33f1c0
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
---
 sm6150.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/sm6150.mk b/sm6150.mk
index d5ef2592f..2b940f015 100644
--- a/sm6150.mk
+++ b/sm6150.mk
@@ -59,6 +59,8 @@ PRODUCT_PACKAGES += \
 PRODUCT_PACKAGES += \
     libaudio-resampler
 
+$(call soong_config_set_bool,android_hardware_audio,skip_speaker_layout_channel_mask_field,true)
+
 ifeq ($(TARGET_USES_DOLBY),true)
 PRODUCT_COPY_FILES += \
     $(LOCAL_PATH)/configs/audio/audio_effects_dolby.xml:$(TARGET_COPY_OUT_VENDOR)/etc/audio_effects.xml \
-- 
2.50.1.windows.1

